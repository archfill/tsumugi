# Require confirmation for tsumugi commands that can mutate a database, contact
# a private runtime, or start a stateful smoke, archive, migration, or eval workflow.

prefix_rule(
    pattern = ["pnpm", ["db:migrate", "db:studio", "db:smoke", "search:smoke", "mcp:smoke", "memory:audit", "memory:audit:dev", "memory:archive", "memory:archive:dev", "capture:retire-legacy", "capture:retire-legacy:dev", "bench", "bench:search"]],
    decision = "prompt",
    justification = "This tsumugi script may access or mutate a database or private runtime. Confirm the target and scope first.",
    match = [
        "pnpm db:migrate",
        "pnpm memory:archive",
        "pnpm bench:search",
    ],
    not_match = [
        "pnpm typecheck",
        "pnpm test",
        "pnpm db:generate",
    ],
)

prefix_rule(
    pattern = ["pnpm", "run", ["db:migrate", "db:studio", "db:smoke", "search:smoke", "mcp:smoke", "memory:audit", "memory:audit:dev", "memory:archive", "memory:archive:dev", "capture:retire-legacy", "capture:retire-legacy:dev", "bench", "bench:search"]],
    decision = "prompt",
    justification = "This tsumugi script may access or mutate a database or private runtime. Confirm the target and scope first.",
    match = [
        "pnpm run db:migrate",
        "pnpm run memory:audit",
    ],
    not_match = [
        "pnpm run typecheck",
        "pnpm run test",
    ],
)

prefix_rule(
    pattern = ["pnpm", ["-C", "--filter"], ["apps/server", "@tsumugi/server"], ["db:migrate", "db:studio", "db:smoke", "search:smoke", "mcp:smoke", "memory:audit", "memory:audit:dev", "memory:archive", "memory:archive:dev", "capture:retire-legacy", "capture:retire-legacy:dev", "bench", "bench:search"]],
    decision = "prompt",
    justification = "This tsumugi server script may access or mutate a database or private runtime. Confirm the target and scope first.",
    match = [
        "pnpm -C apps/server db:migrate",
        "pnpm -C apps/server bench:search",
        "pnpm --filter @tsumugi/server memory:archive",
    ],
    not_match = [
        "pnpm -C apps/server typecheck",
        "pnpm --filter @tsumugi/server test",
        "pnpm -C apps/server db:generate",
    ],
)

prefix_rule(
    pattern = ["pnpm", ["-C", "--filter"], ["apps/server", "@tsumugi/server"], "run", ["db:migrate", "db:studio", "db:smoke", "search:smoke", "mcp:smoke", "memory:audit", "memory:audit:dev", "memory:archive", "memory:archive:dev", "capture:retire-legacy", "capture:retire-legacy:dev", "bench", "bench:search"]],
    decision = "prompt",
    justification = "This tsumugi server script may access or mutate a database or private runtime. Confirm the target and scope first.",
    match = [
        "pnpm -C apps/server run db:migrate",
        "pnpm --filter @tsumugi/server run memory:archive",
    ],
    not_match = [
        "pnpm -C apps/server run typecheck",
    ],
)

prefix_rule(
    pattern = ["drizzle-kit", ["migrate", "studio"]],
    decision = "prompt",
    justification = "Drizzle migrate/studio can access or mutate the configured database. Confirm that the target is disposable or explicitly authorized.",
    match = [
        "drizzle-kit migrate",
        "drizzle-kit studio",
    ],
    not_match = [
        "drizzle-kit generate",
    ],
)

prefix_rule(
    pattern = ["pnpm", "exec", "drizzle-kit", ["migrate", "studio"]],
    decision = "prompt",
    justification = "Drizzle migrate/studio can access or mutate the configured database. Confirm that the target is disposable or explicitly authorized.",
    match = [
        "pnpm exec drizzle-kit migrate",
    ],
    not_match = [
        "pnpm exec drizzle-kit generate",
    ],
)

prefix_rule(
    pattern = ["npx", "drizzle-kit", ["migrate", "studio"]],
    decision = "prompt",
    justification = "Drizzle migrate/studio can access or mutate the configured database. Confirm that the target is disposable or explicitly authorized.",
    match = [
        "npx drizzle-kit migrate",
    ],
    not_match = [
        "npx drizzle-kit generate",
    ],
)
