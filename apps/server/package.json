{
  "name": "@tsumugi/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts --http",
    "dev:http": "tsx watch src/index.ts --http",
    "dev:stdio": "tsx watch src/index.ts --stdio",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "start:stdio": "node dist/index.js --stdio",
    "lint": "echo 'lint: not configured yet'",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "check": "pnpm typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:smoke": "tsx src/data/smoke.ts",
    "search:smoke": "tsx src/core/search/smoke.ts",
    "eval:search-provenance-policy": "node dist/core/search/provenance-policy.eval.js",
    "eval:search-provenance-policy:dev": "tsx src/core/search/provenance-policy.eval.ts",
    "mcp:smoke": "tsx src/interfaces/mcp/smoke.ts",
    "memory:audit": "node dist/interfaces/cli/memory-quality-audit.js",
    "memory:audit:dev": "tsx src/interfaces/cli/memory-quality-audit.ts",
    "memory:archive": "node dist/interfaces/cli/memory-archive.js",
    "memory:archive:dev": "tsx src/interfaces/cli/memory-archive.ts",
    "capture:retire-legacy": "node dist/interfaces/cli/retire-legacy-capture-windows.js",
    "capture:retire-legacy:dev": "tsx src/interfaces/cli/retire-legacy-capture-windows.ts",
    "bench": "tsx eval/cli.ts",
    "bench:search": "tsx eval/cli.ts search"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tsumugi/shared": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
